              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns the notification rules for a bucket."
        },
        {
          "info": {
            "name": "Backblaze B2 Native API Set Bucket Notification Rules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.backblazeb2.com/b2api/v4/b2_set_bucket_notification_rules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets the notification rules for a bucket. Replaces all existing notification rules."
        }
      ]
    }
  ],
  "bundled": true
